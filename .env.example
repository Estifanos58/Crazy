# Crazy Card Game Environment Configuration

# Backend
# Local non-Docker development uses REDIS_URL; Docker Compose connects to internal redis://redis:6379
# unless DOCKER_REDIS_URL is explicitly overridden.
# In production (NODE_ENV=production), Redis is always mandatory.
PORT=3001
BACKEND_PORT=3001
REDIS_URL=redis://localhost:6379
# DOCKER_REDIS_URL=redis://redis:6379
# ALLOW_MEMORY_STORE=true  # Non-production ONLY: explicitly allow in-memory fallback when Redis is not running
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false
MAX_CONNECTIONS_PER_IP=25
# METRICS_TOKEN=           # Optional Bearer token to protect GET /metrics
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
