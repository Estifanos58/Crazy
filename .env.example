# Crazy Card Game Environment Configuration

# Backend (local non-Docker dev uses REDIS_URL; Docker Compose defaults to internal redis://redis:6379 unless DOCKER_REDIS_URL is set)
PORT=3001
BACKEND_PORT=3001
REDIS_URL=redis://localhost:6379
# DOCKER_REDIS_URL=redis://redis:6379
REDIS_REQUIRED=false
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
NODE_ENV=development

# Frontend
FRONTEND_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000
